{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "module": "ESNext",
    "paths": {
      "@/*": ["./src/*"],
      "@shared/types": ["../shared/types/index"]
    }
  },
  "include": ["src/**/*"],
  "references": [{ "path": "../shared" }]
}
